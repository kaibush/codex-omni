# Example systemd unit. Copy to /etc/systemd/system/codex-omni-api.service
# and replace the directory, Node binary, and public origin before enabling.
[Unit]
Description=Codex Omni production API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/codex-omni/apps/server
Environment=CODEX_OMNI_HOST=127.0.0.1
Environment=CODEX_OMNI_PORT=8791
Environment=CODEX_OMNI_ORIGIN=https://example.com
Environment=CODEX_OMNI_INSTANCE=prod
Environment=CODEX_OMNI_DATABASE=/var/lib/codex-omni/codex-omni.db
Environment=COOKIE_SECURE=true
ExecStart=/usr/bin/node dist/cli/codex-omni.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
