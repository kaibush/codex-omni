# Example only. Copy this file into your Caddy config and replace example.com.
# Publish the frontend to /var/www/codex-omni with deploy/publish-frontend.sh.
# The production API listens on 127.0.0.1:8791. Dev stays on 5173 and 8790.
# Do not encode chat or terminal streams; compression waits for EOF.
#
# Optional edge limit. The API already throttles login and setup.
# This block needs the rate_limit module (xcaddy build --with github.com/mholt/caddy-ratelimit).
# Limits only the login/setup endpoints; normal API traffic is untouched.

(login_guard) {
	@login_write {
		method POST
		path /api/auth/login /api/auth/setup
	}
	rate_limit @login_write {
		zone login_api {
			key {http.request.host}|{http.request.client_ip}
			events 12
			window 1m
		}
	}
}

example.com {
	import login_guard
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8791 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	@immutable_assets path /assets/*
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

	@html_shell path / /index.html
	header @html_shell Cache-Control "no-cache"

	handle {
		encode zstd gzip
		root * /var/www/codex-omni
		try_files {path} /index.html
		file_server
	}
}
