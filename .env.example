CODEX_OMNI_HOST=0.0.0.0
CODEX_OMNI_PORT=8790
CODEX_OMNI_API_URL=http://127.0.0.1:8790
# 留空则回显请求 Origin，便于通过公网 IP 访问。也可写成逗号分隔白名单。
CODEX_OMNI_ORIGIN=
CODEX_OMNI_DATABASE=./data/codex-omni.db
# 可选：限制目录浏览范围，逗号分隔。默认从系统根目录开始。
CODEX_OMNI_FS_ROOTS=
CODEX_BIN=codex
CODEX_HOME=
COOKIE_SECURE=false
# 可选：覆盖展示/比较用的版本号。不设则用 package.json。
CODEX_OMNI_VERSION=
# 可选：GitHub Releases 仓库，默认 kaibush/codex-omni。
CODEX_OMNI_GITHUB_REPO=kaibush/codex-omni
