{
  "name": "@codex-omni/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @codex-omni/protocol build && pnpm --filter @codex-omni/db build && pnpm --filter @codex-omni/codex-runtime build && tsx watch --exclude './data/**' --exclude './dist/**' --exclude '**/*.db*' --exclude '**/runtime/**' src/index.ts",
    "dev:stable": "pnpm --filter @codex-omni/protocol build && pnpm --filter @codex-omni/db build && pnpm --filter @codex-omni/codex-runtime build && tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/codex-omni.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests src",
    "user:create": "tsx src/cli/create-user.ts"
  },
  "dependencies": {
    "@codex-omni/codex-runtime": "workspace:*",
    "@codex-omni/db": "workspace:*",
    "@codex-omni/protocol": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.5.0",
    "nanoid": "^5.1.5",
    "node-pty": "^1.1.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "bin": {
    "codex-omni": "dist/cli/codex-omni.js"
  },
  "files": [
    "dist",
    "public"
  ]
}
