{
  "name": "codex-omni",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm build && pnpm --parallel --filter @codex-omni/server --filter @codex-omni/web dev",
    "dev:fast": "pnpm --parallel --filter @codex-omni/server --filter @codex-omni/web dev",
    "dev:stable": "pnpm --parallel --filter @codex-omni/server --filter @codex-omni/web dev:stable",
    "dev:server": "pnpm --filter @codex-omni/server dev",
    "dev:web": "pnpm --filter @codex-omni/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --filter \"./packages/**\" build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "ci:check": "pnpm typecheck && pnpm test && pnpm lint",
    "format": "prettier --write .",
    "user:create": "pnpm --filter @codex-omni/server user:create",
    "start": "pnpm --filter @codex-omni/server start",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "type": "module",
  "version": "0.1.0"
}
